---
import { getCollection } from "astro:content";
import { AppList } from "../app-list";
import { CategoryHeading } from "../category-heading";
import { categories } from "@/lib/categories";

const randomCategory = categories[Math.floor(Math.random() * categories.length)];
const apps = await getCollection("apps", (entry) => entry.data.categories.includes(randomCategory.id));
const randomApps = apps
	.sort(() => Math.random() - 0.5)
	.slice(0, 5);

Astro.response.headers.set("Cache-Control", "private, max-age=60")
---


<CategoryHeading category={randomCategory}/>
<AppList apps={randomApps}/>
