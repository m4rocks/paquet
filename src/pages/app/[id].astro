---
import { AppPageCard } from '@/components/app-sections/app-page-card';
import { AppScreenshotsCarousel } from '@/components/app-sections/app-screenshots-carousel';
import { FeaturesList } from '@/components/app-sections/features';
import { AppListItemSkeleton } from '@/components/skeletons/app-list-item-skeleton';
import { SectionHeading } from '@/components/section-heading';
import { CategoryIcon } from '@/components/category-icon';
import Layout from '@/layouts/layout.astro';
import { getCategory } from '@/lib/categories';
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Links } from '@/components/app-sections/links';
import { AppList } from '@/components/app-list';
import { relatedApps } from '@/lib/app-queries';
import RandomFromCategory from '@/components/server-islands/random-from-category.astro';
import GithubRelease from '@/components/server-islands/github-release.astro';


export const getStaticPaths: GetStaticPaths = async () => {
	const apps = await getCollection("apps");

	return apps.map((app) => ({
		params: { id: app.id },
		props: { app }
	}))
}

interface Props {
	app: CollectionEntry<"apps">
}

const { app } = Astro.props;
const related = relatedApps(app, await getCollection("apps"), 5);
const appCategories = app.data.categories.map(getCategory).filter((category) => !!category);
// Opaque, so the navbar can wear it at the top and the hero gradient continues from it without a seam.
const heroTint = `color-mix(in oklab, ${app.data.accentColor} 60%, var(--background))`;
---

<Layout
	title={app.data.name}
	back
	disableTopPadding
	themeColor={app.data.accentColor + "99"}
	navbarTint={heroTint}
>
	<div
		style={{
			background: `linear-gradient(to bottom, ${heroTint} calc(4rem + env(safe-area-inset-top)), var(--background) 75%)`
		}}
		class="pt-[calc(4rem_+_env(safe-area-inset-top))]"
	>
		<div class="container pt-2">
			<AppPageCard
				app={app}
				client:load
			/>
		</div>
	</div>

	<div class="container space-y-10 mt-10">
		{app.data.screenshots?.length ?
			<AppScreenshotsCarousel
				appId={app.id}
				appName={app.data.name}
				screenshotsLength={app.data.screenshots.length}
				accentColor={app.data.accentColor}
				client:load
			/>
		: null}

		{app.data.description || appCategories.length ?
			<section class="space-y-3">
				<SectionHeading>About</SectionHeading>
				{app.data.description ?
					<p class="max-w-[70ch] text-pretty leading-relaxed">
						{app.data.description}
					</p>
				: null}
				<div class="flex flex-row flex-wrap gap-2 pt-1">
					{appCategories.map((category) => (
						<a
							href={`/category/${category.id}`}
							class="flex flex-row items-center gap-2 rounded-full border bg-card py-1 pl-1 pr-3 text-sm font-semibold transition-colors hover:bg-accent"
						>
							<CategoryIcon category={category} className="size-6"/>
							{category.name}
						</a>
					))}
				</div>
			</section>
		: null}

		<FeaturesList
			features={app.data.features}
			accentColor={app.data.accentColor}
		/>

		{app.data.githubUrl && app.data.syncGitHubReleases ?
			<GithubRelease
				server:defer
			/>
		: null}

		<Links
			app={app}
		/>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-10 pt-4">
			{related.length > 0 ?
				<section class="flex flex-col gap-4">
					<SectionHeading>Related apps</SectionHeading>
					<AppList apps={related}/>
				</section>
			: null}

			<section class="flex flex-col gap-4">
				<SectionHeading>Other apps</SectionHeading>
				<RandomFromCategory server:defer categories={app.data.categories}>
					<div slot="fallback" class="flex flex-col gap-2">
						{Array(5).fill(null).map((_, idx) => (
							<AppListItemSkeleton
								separator={idx !== 4}
							/>
						))}
					</div>
				</RandomFromCategory>
			</section>
		</div>
	</div>
</Layout>
